{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agi-public",
  "main": "workers/suite-gateway.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/portfolio-signals",
      "/portfolio-signals/*",
      "/impact-relay",
      "/impact-relay/*",
      "/fund-intel",
      "/fund-intel/*",
      "/workspace",
      "/workspace/",
      "/workspace.html",
    ],
  },
}
