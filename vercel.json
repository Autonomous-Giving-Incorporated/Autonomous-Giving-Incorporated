{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/fund-intel",
      "destination": "/portfolio-signals",
      "permanent": true
    },
    {
      "source": "/fund-intel/:path*",
      "destination": "/portfolio-signals/:path*",
      "permanent": true
    },
    {
      "source": "/workspace",
      "destination": "/portfolio-signals/workspace.html",
      "permanent": true
    },
    {
      "source": "/workspace/",
      "destination": "/portfolio-signals/workspace.html",
      "permanent": true
    },
    {
      "source": "/workspace.html",
      "destination": "/portfolio-signals/workspace.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/portfolio-signals/workspace",
      "destination": "https://fund-intel-ten.vercel.app/workspace.html"
    },
    {
      "source": "/portfolio-signals/workspace.html",
      "destination": "https://fund-intel-ten.vercel.app/workspace.html"
    },
    {
      "source": "/portfolio-signals",
      "destination": "https://fund-intel-ten.vercel.app/index.html"
    },
    {
      "source": "/portfolio-signals/",
      "destination": "https://fund-intel-ten.vercel.app/index.html"
    },
    {
      "source": "/portfolio-signals/sponsors",
      "destination": "https://fund-intel-ten.vercel.app/sponsors.html"
    },
    {
      "source": "/portfolio-signals/grants",
      "destination": "https://fund-intel-ten.vercel.app/grants.html"
    },
    {
      "source": "/portfolio-signals/members",
      "destination": "https://fund-intel-ten.vercel.app/members.html"
    },
    {
      "source": "/portfolio-signals/donor-impact",
      "destination": "https://fund-intel-ten.vercel.app/donor-impact.html"
    },
    {
      "source": "/portfolio-signals/finance-impact",
      "destination": "https://fund-intel-ten.vercel.app/finance-impact.html"
    },
    {
      "source": "/portfolio-signals/import-review",
      "destination": "https://fund-intel-ten.vercel.app/import-review.html"
    },
    {
      "source": "/portfolio-signals/:path*",
      "destination": "https://fund-intel-ten.vercel.app/:path*"
    },
    {
      "source": "/impact-relay",
      "destination": "https://impact-relay.vercel.app/index.html"
    },
    {
      "source": "/impact-relay/",
      "destination": "https://impact-relay.vercel.app/index.html"
    },
    {
      "source": "/impact-relay/:path*",
      "destination": "https://impact-relay.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/portfolio-signals/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://utdioxwiskzatwoejgiu.supabase.co; connect-src 'self' https://cloudflareinsights.com https://utdioxwiskzatwoejgiu.supabase.co wss://utdioxwiskzatwoejgiu.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/impact-relay/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://utdioxwiskzatwoejgiu.supabase.co; connect-src 'self' https://cloudflareinsights.com https://utdioxwiskzatwoejgiu.supabase.co wss://utdioxwiskzatwoejgiu.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/autogive-hero(.*)\\.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
